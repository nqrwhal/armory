# armory secrets — copy to .env and fill in. Never commit .env.

# Discord webhook (Server Settings → Integrations → Webhooks → New Webhook → Copy URL)
DISCORD_WEBHOOK_URL=

# GAFShub: log into https://gafshub.com in your browser, then copy the `_t` cookie
# (browser dev tools → Application/Storage → Cookies → gafshub.com → _t) as:
#   GAFSHUB_COOKIE="_t=xxxxxxxxxxxxxxxx"
GAFSHUB_COOKIE=

# CAGuns.net: log into https://caguns.net, accept the 18+ gate, then copy ALL cookies
# for caguns.net as one Cookie-header string:
#   CAGUNS_COOKIES="xf_session=...; xf_user=...; <others>"
CAGUNS_COOKIES=

# iMessage recipient (email or phone number, must be able to receive iMessages)
IMESSAGE_TO=

# LLM (any OpenAI-compatible API) — powers natural-language rules, structured
# extraction, and scam scoring. Leave LLM_API_KEY empty to run keywords-only.
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# reasoning control for Anthropic-style endpoints: disabled | low | on
LLM_THINKING=disabled
